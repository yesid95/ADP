NODE_ENV=development
PORT=3000
TRUST_PROXY=false
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
LOG_LEVEL=info

# Prisma CLI y migraciones.
DATABASE_URL=mysql://adp_app:change_me@127.0.0.1:3306/adp

# Adaptador runtime de Prisma 7 para MySQL/MariaDB.
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_USER=adp_app
DATABASE_PASSWORD=change_me
DATABASE_NAME=adp
DATABASE_CONNECTION_LIMIT=10
AUTH_DATABASE_USER=adp_auth
AUTH_DATABASE_PASSWORD=change_me_auth
MARKET_DATABASE_USER=adp_market
MARKET_DATABASE_PASSWORD=change_me_market
AUDIT_DATABASE_USER=adp_audit_writer
AUDIT_DATABASE_PASSWORD=change_me_audit_writer
AUDITOR_DATABASE_USER=adp_auditor
AUDITOR_DATABASE_PASSWORD=change_me_auditor
PRIVATE_UPLOAD_DIR=./uploads
MAX_PHOTO_BYTES=10485760

# Generar secretos independientes. No reutilizar valores entre ambientes.
JWT_SECRET_BASE64=replace_with_32_random_bytes_in_base64
CONTACT_ENCRYPTION_KEY_BASE64=replace_with_32_random_bytes_in_base64
CONTACT_LOOKUP_KEY_BASE64=replace_with_32_random_bytes_in_base64
AUDIT_HMAC_KEY_BASE64=replace_with_32_random_bytes_in_base64
MFA_ENCRYPTION_KEY_BASE64=replace_with_32_random_bytes_in_base64
BACKUP_ENCRYPTION_KEY_BASE64=replace_with_32_random_bytes_in_base64
MFA_SESSION_TTL_HOURS=12
ACCESS_TOKEN_TTL_MINUTES=10
REFRESH_TOKEN_TTL_DAYS=30

# Desarrollo puede devolver tokens en la respuesta. Produccion exige smtp.
MAIL_MODE=token
APP_PUBLIC_URL=http://127.0.0.1:5173
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=change_me
SMTP_PASSWORD=change_me
SMTP_FROM=ADP <no-reply@example.com>
