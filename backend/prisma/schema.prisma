generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider     = "mysql"
  relationMode = "foreignKeys"
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DELETED
}

enum RoleCode {
  FARMER
  BUYER
  ADMIN
}

enum AuthTokenPurpose {
  VERIFY_EMAIL
  VERIFY_PHONE
  RESET_PASSWORD
}

enum MfaFactorType {
  TOTP
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
}

enum BuyerType {
  WHOLESALER
  DISTRIBUTOR
  STORE
  RESTAURANT
  TRANSPORTER
}

enum FarmStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum ListingStatus {
  DRAFT
  OPEN
  CLOSED
  AWARDED
  CANCELLED
}

enum BidStatus {
  SUBMITTED
  WITHDRAWN
  ACCEPTED
  REJECTED
  EXPIRED
}

enum AuditOutcome {
  SUCCESS
  DENIED
  FAILED
}

model User {
  id          String     @id @default(uuid()) @db.Char(36)
  displayName String     @map("display_name") @db.VarChar(120)
  status      UserStatus @default(PENDING)
  createdAt   DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime   @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt   DateTime?  @map("deleted_at") @db.DateTime(3)
  version     Int        @default(1) @db.UnsignedInt

  privateContact              UserPrivateContact?
  passwordCredential          PasswordCredential?
  roles                       UserRole[]                    @relation("UserRoles")
  roleAssignments             UserRole[]                    @relation("RoleAssignedBy")
  authSessions                AuthSession[]
  authTokens                  AuthToken[]
  mfaFactors                  MfaFactor[]
  farmerProfile               FarmerProfile?
  buyerProfile                BuyerProfile?
  farms                       Farm[]
  buyerCropInterests          BuyerCropInterest[]
  buyerMunicipalityInterests  BuyerMunicipalityInterest[]
  bids                        Bid[]
  acceptedAwards              ListingAward[]                @relation("AwardAcceptedBy")
  listingStatusChanges        ListingStatusEvent[]           @relation("ListingStatusChangedBy")
  bidStatusChanges            BidStatusEvent[]               @relation("BidStatusChangedBy")
  idempotencyRecords          IdempotencyRecord[]
  auditEvents                 AuditEvent[]

  @@index([status], map: "users_status_idx")
  @@map("users")
}

model UserPrivateContact {
  userId            String    @id @map("user_id") @db.Char(36)
  emailCiphertext   Bytes     @map("email_ciphertext") @db.VarBinary(512)
  emailLookupHash   Bytes     @unique(map: "user_contacts_email_lookup_uq") @map("email_lookup_hash") @db.Binary(32)
  phoneCiphertext   Bytes?    @map("phone_ciphertext") @db.VarBinary(512)
  phoneLookupHash   Bytes?    @unique(map: "user_contacts_phone_lookup_uq") @map("phone_lookup_hash") @db.Binary(32)
  keyVersion        Int       @map("key_version") @db.UnsignedSmallInt
  emailVerifiedAt   DateTime? @map("email_verified_at") @db.DateTime(3)
  phoneVerifiedAt   DateTime? @map("phone_verified_at") @db.DateTime(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("user_private_contacts")
}

model PasswordCredential {
  userId           String    @id @map("user_id") @db.Char(36)
  passwordHash     String    @map("password_hash") @db.VarChar(255)
  passwordChangedAt DateTime @map("password_changed_at") @db.DateTime(3)
  failedLoginCount Int       @default(0) @map("failed_login_count") @db.UnsignedSmallInt
  lockedUntil      DateTime? @map("locked_until") @db.DateTime(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("password_credentials")
}

model UserRole {
  userId           String   @map("user_id") @db.Char(36)
  roleCode         RoleCode @map("role_code")
  assignedByUserId String?  @map("assigned_by_user_id") @db.Char(36)
  assignedAt       DateTime @default(now()) @map("assigned_at") @db.DateTime(3)

  user       User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Restrict)
  assignedBy User? @relation("RoleAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@id([userId, roleCode])
  @@index([roleCode, userId], map: "user_roles_role_idx")
  @@map("user_roles")
}

model AuthSession {
  id                   String    @id @default(uuid()) @db.Char(36)
  userId               String    @map("user_id") @db.Char(36)
  refreshTokenHash     Bytes     @unique(map: "auth_sessions_refresh_hash_uq") @map("refresh_token_hash") @db.Binary(32)
  expiresAt            DateTime  @map("expires_at") @db.DateTime(3)
  lastUsedAt           DateTime? @map("last_used_at") @db.DateTime(3)
  revokedAt            DateTime? @map("revoked_at") @db.DateTime(3)
  rotatedFromSessionId String?   @unique(map: "auth_sessions_rotated_from_uq") @map("rotated_from_session_id") @db.Char(36)
  ipPrefixHash         Bytes?    @map("ip_prefix_hash") @db.Binary(32)
  userAgentHash        Bytes?    @map("user_agent_hash") @db.Binary(32)
  createdAt            DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  rotatedFrom AuthSession? @relation("AuthSessionRotation", fields: [rotatedFromSessionId], references: [id], onDelete: SetNull)
  rotatedTo   AuthSession? @relation("AuthSessionRotation")

  @@index([userId, revokedAt, expiresAt], map: "auth_sessions_user_active_idx")
  @@index([expiresAt], map: "auth_sessions_expiry_idx")
  @@map("auth_sessions")
}

model AuthToken {
  id        String           @id @default(uuid()) @db.Char(36)
  userId    String           @map("user_id") @db.Char(36)
  purpose   AuthTokenPurpose
  tokenHash Bytes            @unique(map: "auth_tokens_hash_uq") @map("token_hash") @db.Binary(32)
  expiresAt DateTime         @map("expires_at") @db.DateTime(3)
  usedAt    DateTime?        @map("used_at") @db.DateTime(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, usedAt, expiresAt], map: "auth_tokens_user_purpose_idx")
  @@map("auth_tokens")
}

model MfaFactor {
  id               String        @id @default(uuid()) @db.Char(36)
  userId           String        @map("user_id") @db.Char(36)
  factorType       MfaFactorType @map("factor_type")
  secretCiphertext Bytes         @map("secret_ciphertext") @db.VarBinary(512)
  keyVersion       Int           @map("key_version") @db.UnsignedSmallInt
  enabledAt        DateTime      @map("enabled_at") @db.DateTime(3)
  lastUsedStep     BigInt?       @map("last_used_step") @db.UnsignedBigInt
  revokedAt        DateTime?     @map("revoked_at") @db.DateTime(3)
  createdAt        DateTime      @default(now()) @map("created_at") @db.DateTime(3)

  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  recoveryCodes MfaRecoveryCode[]

  @@index([userId, revokedAt], map: "mfa_factors_user_active_idx")
  @@map("mfa_factors")
}

model MfaRecoveryCode {
  id        String    @id @default(uuid()) @db.Char(36)
  factorId  String    @map("factor_id") @db.Char(36)
  codeHash  Bytes     @unique(map: "mfa_recovery_codes_hash_uq") @map("code_hash") @db.Binary(32)
  usedAt    DateTime? @map("used_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  factor MfaFactor @relation(fields: [factorId], references: [id], onDelete: Cascade)

  @@map("mfa_recovery_codes")
}

model Department {
  id       Int    @id @db.UnsignedSmallInt
  daneCode String @unique(map: "departments_dane_code_uq") @map("dane_code") @db.Char(2)
  name     String @db.VarChar(100)

  municipalities Municipality[]

  @@map("departments")
}

model Municipality {
  id           Int    @id @db.UnsignedSmallInt
  departmentId Int    @map("department_id") @db.UnsignedSmallInt
  daneCode     String @unique(map: "municipalities_dane_code_uq") @map("dane_code") @db.Char(5)
  name         String @db.VarChar(120)

  department    Department                    @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  farms         Farm[]
  buyerInterests BuyerMunicipalityInterest[]

  @@index([departmentId, name], map: "municipalities_department_name_idx")
  @@map("municipalities")
}

model FarmerProfile {
  userId             String             @id @map("user_id") @db.Char(36)
  publicBio          String?            @map("public_bio") @db.Text
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  createdAt          DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@map("farmer_profiles")
}

model BuyerProfile {
  userId             String             @id @map("user_id") @db.Char(36)
  businessName       String?            @map("business_name") @db.VarChar(160)
  buyerType          BuyerType          @map("buyer_type")
  description        String?            @db.Text
  verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
  createdAt          DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([buyerType, verificationStatus], map: "buyer_profiles_type_status_idx")
  @@map("buyer_profiles")
}

model Farm {
  id                 String     @id @default(uuid()) @db.Char(36)
  ownerUserId        String     @map("owner_user_id") @db.Char(36)
  municipalityId     Int        @map("municipality_id") @db.UnsignedSmallInt
  name               String     @db.VarChar(160)
  vereda              String     @db.VarChar(120)
  publicLocationText String     @map("public_location_text") @db.VarChar(200)
  description        String?    @db.Text
  roadAccessNotes    String?    @map("road_access_notes") @db.VarChar(500)
  productiveHectares Decimal?   @map("productive_hectares") @db.Decimal(10, 2)
  status             FarmStatus @default(DRAFT)
  createdAt          DateTime   @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt          DateTime?  @map("deleted_at") @db.DateTime(3)
  version            Int        @default(1) @db.UnsignedInt

  owner        User          @relation(fields: [ownerUserId], references: [id], onDelete: Restrict)
  municipality Municipality  @relation(fields: [municipalityId], references: [id], onDelete: Restrict)
  listings     HarvestListing[]

  @@index([ownerUserId, status], map: "farms_owner_status_idx")
  @@index([municipalityId, status], map: "farms_municipality_status_idx")
  @@map("farms")
}

model CropVariety {
  id        Int      @id @default(autoincrement()) @db.UnsignedSmallInt
  code      String   @unique(map: "crop_varieties_code_uq") @db.VarChar(40)
  name      String   @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)

  buyerInterests BuyerCropInterest[]
  listings       HarvestListing[]

  @@map("crop_varieties")
}

model BuyerCropInterest {
  buyerUserId       String   @map("buyer_user_id") @db.Char(36)
  cropVarietyId     Int      @map("crop_variety_id") @db.UnsignedSmallInt
  minimumQuantityKg Decimal? @map("minimum_quantity_kg") @db.Decimal(12, 3)
  maximumQuantityKg Decimal? @map("maximum_quantity_kg") @db.Decimal(12, 3)
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  buyer       User        @relation(fields: [buyerUserId], references: [id], onDelete: Restrict)
  cropVariety CropVariety @relation(fields: [cropVarietyId], references: [id], onDelete: Restrict)

  @@id([buyerUserId, cropVarietyId])
  @@map("buyer_crop_interests")
}

model BuyerMunicipalityInterest {
  buyerUserId  String   @map("buyer_user_id") @db.Char(36)
  municipalityId Int    @map("municipality_id") @db.UnsignedSmallInt
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)

  buyer       User         @relation(fields: [buyerUserId], references: [id], onDelete: Restrict)
  municipality Municipality @relation(fields: [municipalityId], references: [id], onDelete: Restrict)

  @@id([buyerUserId, municipalityId])
  @@map("buyer_municipality_interests")
}

model HarvestListing {
  id                        String        @id @default(uuid()) @db.Char(36)
  farmId                    String        @map("farm_id") @db.Char(36)
  cropVarietyId             Int           @map("crop_variety_id") @db.UnsignedSmallInt
  estimatedQuantityKg       Decimal       @map("estimated_quantity_kg") @db.Decimal(12, 3)
  availableFromDate         DateTime      @map("available_from_date") @db.Date
  cropConditionNotes        String?       @map("crop_condition_notes") @db.VarChar(500)
  roadAccessSnapshot        String?       @map("road_access_snapshot") @db.VarChar(500)
  expectedPriceCopPerKg     Decimal?      @map("expected_price_cop_per_kg") @db.Decimal(18, 2)
  allowsPartialPurchase     Boolean       @default(false) @map("allows_partial_purchase")
  bidDeadlineAt             DateTime      @map("bid_deadline_at") @db.DateTime(3)
  status                    ListingStatus @default(DRAFT)
  publishedAt               DateTime?     @map("published_at") @db.DateTime(3)
  closedAt                  DateTime?     @map("closed_at") @db.DateTime(3)
  createdAt                 DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                 DateTime      @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt                 DateTime?     @map("deleted_at") @db.DateTime(3)
  version                   Int           @default(1) @db.UnsignedInt

  farm          Farm                 @relation(fields: [farmId], references: [id], onDelete: Restrict)
  cropVariety   CropVariety          @relation(fields: [cropVarietyId], references: [id], onDelete: Restrict)
  photos        HarvestPhoto[]
  bids          Bid[]
  award         ListingAward?
  statusEvents  ListingStatusEvent[]

  @@index([status, bidDeadlineAt], map: "harvest_listings_status_deadline_idx")
  @@index([farmId, createdAt], map: "harvest_listings_farm_created_idx")
  @@index([cropVarietyId, status, availableFromDate], map: "harvest_listings_search_idx")
  @@map("harvest_listings")
}

model HarvestPhoto {
  id         String   @id @default(uuid()) @db.Char(36)
  listingId  String   @map("listing_id") @db.Char(36)
  storageKey String   @map("storage_key") @db.VarChar(512)
  mimeType   String   @map("mime_type") @db.VarChar(50)
  sizeBytes  Int      @map("size_bytes") @db.UnsignedInt
  sha256     Bytes    @db.Binary(32)
  sortOrder  Int      @map("sort_order") @db.UnsignedSmallInt
  createdAt  DateTime @default(now()) @map("created_at") @db.DateTime(3)

  listing HarvestListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, sortOrder], map: "harvest_photos_order_uq")
  @@unique([listingId, sha256], map: "harvest_photos_content_uq")
  @@map("harvest_photos")
}

model Bid {
  id               String    @id @default(uuid()) @db.Char(36)
  listingId        String    @map("listing_id") @db.Char(36)
  buyerUserId      String    @map("buyer_user_id") @db.Char(36)
  anonymousLabel   String    @map("anonymous_label") @db.VarChar(16)
  status           BidStatus @default(SUBMITTED)
  currentVersionNo Int       @default(1) @map("current_version_no") @db.UnsignedSmallInt
  submittedAt      DateTime  @default(now()) @map("submitted_at") @db.DateTime(3)
  withdrawnAt      DateTime? @map("withdrawn_at") @db.DateTime(3)
  createdAt        DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime  @updatedAt @map("updated_at") @db.DateTime(3)
  version          Int       @default(1) @db.UnsignedInt

  listing      HarvestListing  @relation(fields: [listingId], references: [id], onDelete: Restrict)
  buyer        User            @relation(fields: [buyerUserId], references: [id], onDelete: Restrict)
  versions     BidVersion[]
  award        ListingAward?   @relation("WinningBid")
  statusEvents BidStatusEvent[]

  @@unique([listingId, buyerUserId], map: "bids_listing_buyer_uq")
  @@unique([listingId, anonymousLabel], map: "bids_listing_label_uq")
  @@unique([listingId, id], map: "bids_listing_id_uq")
  @@index([listingId, status, submittedAt], map: "bids_listing_status_idx")
  @@index([buyerUserId, status, submittedAt], map: "bids_buyer_status_idx")
  @@map("bids")
}

model BidVersion {
  bidId                  String   @map("bid_id") @db.Char(36)
  versionNo              Int      @map("version_no") @db.UnsignedSmallInt
  unitPriceCopPerKg      Decimal  @map("unit_price_cop_per_kg") @db.Decimal(18, 2)
  offeredQuantityKg      Decimal  @map("offered_quantity_kg") @db.Decimal(12, 3)
  transportIncluded      Boolean  @default(false) @map("transport_included")
  pickupAtFarm           Boolean  @default(false) @map("pickup_at_farm")
  sellerLogisticsCostCop Decimal  @default(0) @map("seller_logistics_cost_cop") @db.Decimal(18, 2)
  advanceAmountCop       Decimal  @default(0) @map("advance_amount_cop") @db.Decimal(18, 2)
  paymentTermDays        Int      @map("payment_term_days") @db.UnsignedSmallInt
  continuityMonths       Int?     @map("continuity_months") @db.UnsignedSmallInt
  continuityNotes        String?  @map("continuity_notes") @db.VarChar(500)
  observations           String?  @db.Text
  createdAt              DateTime @default(now()) @map("created_at") @db.DateTime(3)

  bid   Bid           @relation(fields: [bidId], references: [id], onDelete: Restrict)
  award ListingAward? @relation("WinningBidVersion")

  @@id([bidId, versionNo])
  @@map("bid_versions")
}

model ListingAward {
  listingId               String    @id @map("listing_id") @db.Char(36)
  bidId                   String    @unique(map: "listing_awards_bid_uq") @map("bid_id") @db.Char(36)
  bidVersionNo            Int       @map("bid_version_no") @db.UnsignedSmallInt
  acceptedByUserId        String    @map("accepted_by_user_id") @db.Char(36)
  acceptedAt              DateTime  @map("accepted_at") @db.DateTime(3)
  buyerIdentityRevealedAt DateTime? @map("buyer_identity_revealed_at") @db.DateTime(3)
  whatsappOpenedAt        DateTime? @map("whatsapp_opened_at") @db.DateTime(3)
  createdAt               DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  listing   HarvestListing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  bid       Bid            @relation("WinningBid", fields: [listingId, bidId], references: [listingId, id], onDelete: Restrict)
  bidVersion BidVersion    @relation("WinningBidVersion", fields: [bidId, bidVersionNo], references: [bidId, versionNo], onDelete: Restrict)
  acceptedBy User          @relation("AwardAcceptedBy", fields: [acceptedByUserId], references: [id], onDelete: Restrict)

  @@unique([listingId, bidId], map: "listing_awards_listing_bid_uq")
  @@unique([bidId, bidVersionNo], map: "listing_awards_bid_version_uq")
  @@map("listing_awards")
}

model ListingStatusEvent {
  id              BigInt         @id @default(autoincrement()) @db.UnsignedBigInt
  listingId       String         @map("listing_id") @db.Char(36)
  fromStatus      ListingStatus? @map("from_status")
  toStatus        ListingStatus  @map("to_status")
  changedByUserId String?        @map("changed_by_user_id") @db.Char(36)
  reasonCode      String?        @map("reason_code") @db.VarChar(50)
  createdAt       DateTime       @default(now()) @map("created_at") @db.DateTime(3)

  listing  HarvestListing @relation(fields: [listingId], references: [id], onDelete: Restrict)
  changedBy User?          @relation("ListingStatusChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([listingId, createdAt, id], map: "listing_status_events_timeline_idx")
  @@map("listing_status_events")
}

model BidStatusEvent {
  id              BigInt     @id @default(autoincrement()) @db.UnsignedBigInt
  bidId           String     @map("bid_id") @db.Char(36)
  fromStatus      BidStatus? @map("from_status")
  toStatus        BidStatus  @map("to_status")
  changedByUserId String?    @map("changed_by_user_id") @db.Char(36)
  reasonCode      String?    @map("reason_code") @db.VarChar(50)
  createdAt       DateTime   @default(now()) @map("created_at") @db.DateTime(3)

  bid       Bid   @relation(fields: [bidId], references: [id], onDelete: Restrict)
  changedBy User? @relation("BidStatusChangedBy", fields: [changedByUserId], references: [id], onDelete: SetNull)

  @@index([bidId, createdAt, id], map: "bid_status_events_timeline_idx")
  @@map("bid_status_events")
}

model IdempotencyRecord {
  id                 String    @id @default(uuid()) @db.Char(36)
  userId             String    @map("user_id") @db.Char(36)
  operationCode      String    @map("operation_code") @db.VarChar(50)
  idempotencyKeyHash Bytes     @map("idempotency_key_hash") @db.Binary(32)
  requestHash        Bytes     @map("request_hash") @db.Binary(32)
  resourceType       String?   @map("resource_type") @db.VarChar(40)
  resourceId         String?   @map("resource_id") @db.Char(36)
  responseCode       Int?      @map("response_code") @db.UnsignedSmallInt
  expiresAt          DateTime  @map("expires_at") @db.DateTime(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([userId, operationCode, idempotencyKeyHash], map: "idempotency_operation_key_uq")
  @@index([expiresAt], map: "idempotency_expiry_idx")
  @@map("idempotency_records")
}

model AuditEvent {
  id          BigInt       @id @default(autoincrement()) @db.UnsignedBigInt
  occurredAt  DateTime     @default(now()) @map("occurred_at") @db.DateTime(3)
  actorUserId String?      @map("actor_user_id") @db.Char(36)
  actionCode  String       @map("action_code") @db.VarChar(80)
  entityType  String       @map("entity_type") @db.VarChar(40)
  entityId    String?      @map("entity_id") @db.Char(36)
  outcome     AuditOutcome
  requestId   String       @map("request_id") @db.Char(36)
  ipHash      Bytes?       @map("ip_hash") @db.Binary(32)
  metadata    Json?
  previousHash Bytes?      @map("previous_hash") @db.Binary(32)
  eventHash   Bytes        @map("event_hash") @db.Binary(32)

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([occurredAt, id], map: "audit_events_time_idx")
  @@index([actorUserId, occurredAt], map: "audit_events_actor_idx")
  @@index([actionCode, occurredAt], map: "audit_events_action_idx")
  @@index([entityType, entityId, occurredAt], map: "audit_events_entity_idx")
  @@index([requestId], map: "audit_events_request_idx")
  @@map("audit_events")
}
