{
  "name": "@adp/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:wait": "tsx scripts/wait-for-database.ts",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:recovery:drill": "tsx scripts/recovery-drill.ts",
    "db:plans": "tsx scripts/verify-query-plans.ts",
    "test:load": "tsx scripts/load-smoke.ts",
    "validate": "npm run prisma:validate && npm run typecheck && npm test && npm run build",
    "validate:database": "npm run db:wait && npm run db:migrate:deploy && npm run db:seed && npm run test:integration"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.9.1",
    "@prisma/client": "7.9.1",
    "argon2": "^0.45.1",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jose": "^6.2.10",
    "mariadb": "^3.5.3",
    "nodemailer": "^9.0.6",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "pino-pretty": "^13.1.3",
    "prisma": "7.9.1",
    "supertest": "^7.2.2",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "argon2@0.45.1": true,
    "esbuild@0.28.2": true,
    "prisma@7.9.1": true
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
}
